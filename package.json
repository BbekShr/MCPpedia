    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dotenv": "^17.4.0",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "next": "16.3.3",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
