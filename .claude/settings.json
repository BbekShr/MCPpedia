{
  "permissions": {
    "allow": [
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git checkout:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/org_guard.py\" bash", "timeout": 5 }]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/org_guard.py\" edit", "timeout": 5 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/org_guard.py\" stop", "timeout": 120 }]
      }
    ]
  }
}
