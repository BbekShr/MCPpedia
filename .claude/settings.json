{
  "permissions": {
    "allow": [
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git checkout:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-admin-merge.py\""
          }
        ]
      }
    ]
  }
}
